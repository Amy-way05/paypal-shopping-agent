# Copy to backend/.env and fill in. Never commit .env.

# PayPal (SANDBOX ONLY — base URL is hardcoded to api-m.sandbox.paypal.com)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# Google Gemini (google-genai SDK). Set a current GA Flash model name.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# Product search (optional; falls back to local data/products.json)
CHANNEL3_API_KEY=
USE_CHANNEL3=false

# SQLite file (relative to backend/)
DB_PATH=app.db

# Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:5173
