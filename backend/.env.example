# Copy to backend/.env and fill in. Never commit .env.

# PayPal (SANDBOX ONLY: base URL is hardcoded to api-m.sandbox.paypal.com)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# sandbox (default) or off (simulated orders, used by the tests)
PAYPAL_MODE=sandbox

# Google Gemini (google-genai SDK)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# comma-separated; gemini-flash-lite-latest is always tried last
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
GEMINI_TIMEOUT_MS=12000
# on (default) or off (template messages only)
LLM_MODE=on

# Where PayPal sends the buyer after approving / cancelling
FRONTEND_URL=http://localhost:5173

# Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Optional: where the generated dataset lives (default: <repo>/data)
DATA_DIR=
